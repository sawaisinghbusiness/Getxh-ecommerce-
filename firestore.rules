rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        (request.auth.uid == "XVQ4WNIRyKbJz7HCDUmU0Lv9squ2" || request.auth.token.email == "agency@getxh.in");
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(keys);
    }

    // ── 1. Users Wallet & Balance ──
    // SECURITY: Users can only CREATE their doc with zero or welcome bonus balance (up to 500).
    //           Balance/TotalOrders/TotalSpent change only on the server (Admin SDK):
    //           /wallet/verify credits top-ups and /order charges orders.
    match /Users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isAdmin() || (isOwner(userId) &&
        request.resource.data.Balance >= 0 &&
        request.resource.data.Balance <= 500 &&
        request.resource.data.TotalOrders == 0 &&
        request.resource.data.TotalSpent == 0);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── 2. User Profiles ──
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isOwner(userId) &&
        request.resource.data.uid == request.auth.uid &&
        !('password' in request.resource.data) &&
        (!('balance' in request.resource.data) || (request.resource.data.balance >= 0 && request.resource.data.balance <= 500));
      allow update: if isOwner(userId) &&
        !('password' in request.resource.data) &&
        onlyChanged(['username', 'mobile', 'email', 'uid', 'createdAt', 'authProvider']);
      allow delete: if isAdmin();
    }

    // ── 3. Orders ──
    // SECURITY: Orders are created by the server (/order) with the server-side price.
    //           Users can only update status-related fields on their own orders.
    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid &&
        onlyChanged(['status', 'apiStatus', 'updatedAt', 'remains', 'start_count', 'end_count', 'completedAt']));
      allow delete: if isAdmin();
    }

    // ── 4. Tickets & Support ──
    match /tickets/{ticketId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ── 5. Messages ──
    match /messages/{messageId} {
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/tickets/$(resource.data.ticketId)) && get(/databases/$(database)/documents/tickets/$(resource.data.ticketId)).data.userId == request.auth.uid);
    }

    // ── 6. App User Data (Admin Panel Users) ──
    // SECURITY: Block password field from being stored in Firestore.
    match /userData/{userId} {
      allow create: if isOwner(userId) && !('password' in request.resource.data);
      allow update: if isOwner(userId) && !('password' in request.resource.data);
      allow read: if isAdmin() || isOwner(userId);
    }

    // ── 7. OTP Codes ──
    // SECURITY: Only admin should read/write OTP codes.
    // Backend uses Admin SDK (bypasses rules), so client access is fully blocked.
    match /otp_codes/{docId} {
      allow read, write: if isAdmin();
    }

    // ── 8. Blogs ──
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 9. Wallet Transactions ──
    // SECURITY: list now requires uid filter to prevent cross-user data leaks.
    // Users can mark their own transactions as 'notified' for real-time notification popups.
    match /walletTxns/{txnId} {
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow get: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['notified']));
      allow delete: if isAdmin();
    }

    // ── 10. Fund Payments (BharatPe UPI & Wallet Deposits) ──
    // SECURITY: Created only by the server (/wallet/verify) after BharatPe verification.
    match /fundPayments/{paymentId} {
      allow list, get: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ── 11. App Config & Dynamic Services Catalog ──
    // SECURITY: Only admin can write. Was previously writable by any signed-in user.
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 12. Custom Campaign & Tracking Links ──
    match /campaigns/{campaignId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // SECURITY: Non-admin can ONLY update click/conversion counters, nothing else.
      // Changed hasAny → hasOnly to prevent piggybacking other field changes.
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['clicks', 'lastClickedAt', 'conversions', 'lastReferralAt'])
      );

      // SECURITY: Click tracking — require minimum data validation.
      // No auth required (public tracking pixel), but limited fields.
      match /clicks/{clickId} {
        allow create: if request.resource.data.keys().hasOnly(['timestamp', 'referrer', 'userAgent', 'ip', 'createdAt', 'page', 'source', 'ua', 'ts', 'ref']) &&
          request.resource.data.keys().size() <= 8;
        allow read: if isAdmin();
      }

      match /referrals/{refId} {
        allow create: if isSignedIn();
        allow read, update, delete: if isAdmin();
      }

      match /app_config/{configId} {
        allow read, write: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
